# --- LLM (OpenAI-compatible provider) ---
LLM_PROVIDER=none                # none | openrouter | mock
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME  # never commit the real key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=particle-ai/particle-1:free
LLM_TIMEOUT_S=30
LLM_MAX_RPM=20                   # configured provider request ceiling
LLM_MAX_RETRIES=2
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=60
USE_NARRATOR=true
USE_ADVISOR=true
PLANNER_MAX_INPUT_TOKENS=6000
EVAL_PROVIDER=auto               # auto | replay | fallback | openrouter | mock
API_TOKENS=                       # optional token=owner pairs, comma-separated; enables Bearer auth
API_RATE_LIMIT_RPM=120
JOB_MAX_RETRIES=2

# --- Storage / limits ---
ARTIFACTS_DIR=./artifacts
SQLITE_PATH=./artifacts/meta.sqlite
MAX_UPLOAD_MB=100
MAX_ROWS=5000000
QUERY_TIMEOUT_S=15
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
