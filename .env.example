# --- LLM (OpenAI-compatible provider) ---
LLM_PROVIDER=agnes               # agnes | nim | mock | none
NVIDIA_API_KEY=nvapi-REPLACE_ME  # from build.nvidia.com ; never commit the real key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=ibm/granite-3.0-3b-a800m-instruct   # lightweight free-tier candidate; confirm availability via GET /v1/models
AGNES_API_KEY=sk-REPLACE_ME      # from agnes-ai.com; never commit the real key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash      # free Angel User Trial model per Agnes pricing documentation
LLM_TIMEOUT_S=30
LLM_MAX_RPM=40                   # NVIDIA free tier ceiling
LLM_MAX_RETRIES=2
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=60
USE_NARRATOR=true
USE_ADVISOR=true
PLANNER_MAX_INPUT_TOKENS=6000
EVAL_PROVIDER=auto               # auto | replay | fallback | nim | mock
API_TOKENS=                       # optional token=owner pairs, comma-separated; enables Bearer auth
API_RATE_LIMIT_RPM=120
JOB_MAX_RETRIES=2

# --- Storage / limits ---
ARTIFACTS_DIR=./artifacts
SQLITE_PATH=./artifacts/meta.sqlite
MAX_UPLOAD_MB=100
MAX_ROWS=5000000
QUERY_TIMEOUT_S=15
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
